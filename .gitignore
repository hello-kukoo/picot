node_modules/
coverage/
.npm-cache/
.worktrees/
# npm lock file (this project uses bun exclusively; see AGENTS.md)
package-lock.json
.DS_Store

# Tauri build artifacts
src-tauri/target/
src-tauri/gen/

# Pi extension bundles (produced by scripts/build-extensions.js)
extensions/dist/

# Embedded pi binary tree (produced by scripts/fetch-pi-binary.js)
src-tauri/resources/pi/
.cache/pi-binaries/
.cache/terminal-fonts/
.cache/cjk-fonts/

# This repo's public/ is tracked source (vanilla JS WebView), not a static
# build output — un-ignore it against over-broad global ignores (e.g. a
# Gatsby-style `public/` rule in ~/.gitignore_global) so `git add` and the
# husky restage step work.
!public/

# Generated terminal font assets (produced by scripts/fetch-terminal-font.js)
public/fonts/terminal/

# Generated CJK font assets (produced by scripts/fetch-cjk-font.js)
public/fonts/cjk/

# husky internal scripts (managed by `bun run prepare`)
.husky/_/

# Frontend vendor bundles (produced by scripts/build-frontend.js)
public/vendor/

# Agent memory (personal session-derived notes; not for version control)
.memory/

# Zed editor
.zed/

# Agent memory tooling (workspace-private, see .memory/MEMORY.md)
.pi/extensions/auto-memory.ts
.claude/skills/update-memory/
